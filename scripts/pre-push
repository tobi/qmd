#!/usr/bin/env bash
set -euo pipefail

# Pre-push hook: validates v* tag pushes before they reach the remote.
#
# Checks (all fail closed — missing or unreadable data blocks the push):
#   1. package.json version matches the tag
#   2. CHANGELOG.md has a "## [{version}] - {date}" entry
#   3. GitHub Actions has completed, successful `push` runs for the tagged
#      commit on every required workflow (ci.yml, nix.yml)
#
# Non-tag pushes and tag deletions are ignored.

REQUIRED_WORKFLOWS=(ci.yml nix.yml)

fail() {
  echo >&2 "ABORT: $*"
  exit 1
}

# Verify one workflow has only completed, successful push runs for $commit.
require_passing_workflow() {
  local commit="$1" workflow="$2"
  local endpoint="repos/{owner}/{repo}/actions/workflows/${workflow}/runs"
  local query="head_sha=${commit}&event=push&per_page=100"
  local runs_json summary count bad

  if ! runs_json=$(gh api "${endpoint}?${query}" 2>/dev/null); then
    fail "cannot read GitHub Actions '${workflow}' runs for ${commit} (API unreachable or unauthorized)"
  fi

  if ! jq -e '.workflow_runs | type == "array"' >/dev/null 2>&1 <<<"$runs_json"; then
    fail "unexpected GitHub Actions '${workflow}' response for ${commit}"
  fi

  # Only runs for this exact commit and push event count.
  if ! summary=$(jq -r --arg sha "$commit" '
    [.workflow_runs[] | select(.head_sha == $sha and .event == "push")] as $runs
    | "\($runs | length)\t\([$runs[] | select(.status != "completed" or .conclusion != "success") | "\(.status // "unknown")/\(.conclusion // "none")"] | join(","))"
  ' <<<"$runs_json" 2>/dev/null); then
    fail "cannot parse GitHub Actions '${workflow}' runs for ${commit}"
  fi

  IFS=$'\t' read -r count bad <<<"$summary"

  if [[ ! "$count" =~ ^[0-9]+$ ]]; then
    fail "cannot parse GitHub Actions '${workflow}' runs for ${commit}"
  fi

  if [[ "$count" -eq 0 ]]; then
    fail "no GitHub Actions '${workflow}' push run found for ${commit}; push the commit to main and wait for CI"
  fi

  if [[ -n "$bad" ]]; then
    fail "GitHub Actions '${workflow}' is not green for ${commit}: ${bad}"
  fi

  echo >&2 "  CI (${workflow}): ${count} run(s) passed ✓"
}

while read -r local_ref local_sha remote_ref remote_sha; do
  # Only validate v* tag pushes
  if [[ "$local_ref" != refs/tags/v* ]]; then
    continue
  fi

  # Skip tag deletions
  if [[ "$local_sha" == "0000000000000000000000000000000000000000" ]]; then
    continue
  fi

  TAG="${local_ref#refs/tags/}"
  VERSION="${TAG#v}"

  echo >&2 "Validating release $TAG..."

  # --- 1. package.json version must match the tag ---
  PKG_VERSION=$(jq -r .version package.json)
  if [[ "$PKG_VERSION" != "$VERSION" ]]; then
    echo >&2 "ABORT: package.json version is $PKG_VERSION but tag is $TAG"
    echo >&2 "Run: jq --arg v '$VERSION' '.version = \$v' package.json > tmp && mv tmp package.json"
    exit 1
  fi
  echo >&2 "  package.json: $PKG_VERSION ✓"

  # --- 2. CHANGELOG.md must have an entry for this version ---
  if [[ ! -f CHANGELOG.md ]]; then
    echo >&2 "ABORT: CHANGELOG.md not found"
    exit 1
  fi

  if ! grep -q "^## \[$VERSION\] - " CHANGELOG.md; then
    echo >&2 "ABORT: CHANGELOG.md has no entry for [$VERSION]"
    echo >&2 "Expected: ## [$VERSION] - $(date +%Y-%m-%d)"
    exit 1
  fi
  echo >&2 "  CHANGELOG.md: [$VERSION] ✓"

  # --- 3. CI must have passed on GitHub for this commit ---
  # Resolve the tag (annotated or lightweight) to its underlying commit.
  COMMIT=""
  if ! COMMIT=$(git rev-list -n 1 "$local_sha" 2>/dev/null) || [[ -z "$COMMIT" ]] || [[ ! "$COMMIT" =~ ^[0-9a-f]{40}$ ]]; then
    fail "cannot resolve $TAG ($local_sha) to a commit"
  fi

  if ! command -v gh &>/dev/null; then
    fail "gh CLI is required to verify CI for $TAG (install: https://cli.github.com)"
  fi

  if ! command -v jq &>/dev/null; then
    fail "jq is required to verify CI for $TAG"
  fi

  for workflow in "${REQUIRED_WORKFLOWS[@]}"; do
    require_passing_workflow "$COMMIT" "$workflow"
  done

  echo >&2 "All checks passed for $TAG ✓"
done

exit 0
